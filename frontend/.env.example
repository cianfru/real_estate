# Leave unset in production: the app calls /api on its own origin and Vercel rewrites it to
# the API (see vercel.json). Set it only to call an API on another origin directly
# (then the backend needs COOKIE_SAMESITE=none, COOKIE_SECURE=true and CORS_ORIGINS).
# VITE_API_URL=https://your-api.up.railway.app

# Development only: where the Vite dev server proxies /api
# VITE_DEV_API=http://localhost:8000
