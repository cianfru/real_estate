{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "startCommand": "sh -c 'alembic upgrade head && python -m ingest nightly --scope italy'",
    "cronSchedule": "17 1 * * *",
    "restartPolicyType": "NEVER"
  }
}
