# --- required ---------------------------------------------------------------
# Postgres 16 with PostGIS (Neon free tier, Railway PostGIS template, or docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aste
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Public URL of the frontend (used in share links and alert emails)
PUBLIC_APP_URL=http://localhost:5173

# --- cookies / CORS ----------------------------------------------------------
# Production behind Vercel's /api rewrite (recommended): COOKIE_SECURE=true, COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Only needed when the browser calls the API cross-origin (VITE_API_URL set)
CORS_ORIGINS=http://localhost:5173

# --- GDPR ---------------------------------------------------------------------
# Store delegato / custode / viewing-contact names and contacts (pending firm decision)
STORE_PROFESSIONAL_CONTACTS=false

# --- email alerts (Resend free tier). Empty = log instead of sending ------------
RESEND_API_KEY=
EMAIL_FROM=Legal Estate Aste <aste@legalestateitalia.it>

# --- geocoding -------------------------------------------------------------------
# Contact address sent to Nominatim (their usage policy asks for one)
NOMINATIM_EMAIL=
GEOCODE_LIMIT=800

# --- PVP client (defaults are fine) -------------------------------------------------
# PVP_MIN_INTERVAL_S=1.0
# PVP_PAGE_SIZE=500
# UNSEEN_RUNS_BEFORE_UNKNOWN=3
